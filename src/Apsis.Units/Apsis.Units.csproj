<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Apsis.Units</PackageId>
    <Description>Strongly-typed distance and angle value types for .NET, avoiding unit-mixup bugs in scientific and geospatial code.</Description>
    <PackageTags>si;angle;distance;units;meters;radians;degrees;kilometers</PackageTags>
    <Authors>Charles Rasberry</Authors>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../../docs/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
</Project>
